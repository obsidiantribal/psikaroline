---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Beneficios from '../components/Beneficios.astro';
import ParaQuem from '../components/ParaQuem.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Citacao from '../components/Citacao.astro';
import Praticas from '../components/Praticas.astro';
import Duvidas from '../components/Duvidas.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
import WhatsFlutuante from '../components/WhatsFlutuante.astro';
---
<Base>
  <Header />
  <main id="conteudo" class="flex-1">
    <Hero />
    <Sobre />
    <Beneficios />
    <ParaQuem />
    <ComoFunciona />
    <Citacao />
    <Praticas />
    <Duvidas />
    <Contato />
  </main>
  <Footer />
  <WhatsFlutuante />
</Base>
